# Superuser / owner connection. Used by migrations, seeds, and the test harness
# (which creates and drops throwaway databases on this server).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/ticketry_dev

# Runtime connection for the API and the worker. `ticketry_app` does not own
# the tables; it only holds the grants applied by the migrations.
APP_DATABASE_URL=postgres://ticketry_app:ticketry_app@127.0.0.1:5434/ticketry_dev

# HTTP API
PORT=3000
LOG_LEVEL=info

# Worker
WORKER_INTERVAL_MS=60000
