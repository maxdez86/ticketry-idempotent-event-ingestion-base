{
  "name": "@ticketry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "lint": "eslint .",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ticketry/core": "workspace:*",
    "@ticketry/db": "workspace:*",
    "fastify": "^5.3.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@ticketry/test-support": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "3.2.4"
  }
}
