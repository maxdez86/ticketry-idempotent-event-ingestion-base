{
  "name": "ticketry",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Multi-tenant helpdesk API and background workers on PostgreSQL.",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:migrate": "pnpm --filter @ticketry/db migrate",
    "db:seed": "pnpm --filter @ticketry/db seed",
    "dev:api": "pnpm --filter @ticketry/api dev",
    "dev:worker": "pnpm --filter @ticketry/worker dev",
    "precommit:check": "bash scripts/precommit-checks.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "3.2.4"
  }
}
